# =================================================================
# SIH 2026 PS3 APAAR Seat Integrity Platform - Environment Template
# DO NOT store real credentials or secrets in this file.
# Copy this file to .env and replace placeholder values.
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Replace with your actual MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/apaar_seat_integrity?retryWrites=true&w=majority

# Client Application URL (CORS origin)
CLIENT_URL=http://localhost:5173

# JWT Authentication (for future authentication phases)
JWT_SECRET=your_jwt_secret_min_32_characters_random_string_here
JWT_EXPIRES_IN=7d

# Dedicated Keyed HMAC Secret for APAAR Pseudonymisation (DO NOT reuse JWT_SECRET)
APAAR_TOKEN_SECRET=your_apaar_hmac_secret_min_32_chars_random_string_here

# Initial Admin Bootstrap (for future user seeding)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.gov.in
ADMIN_PASSWORD=change_me_secure_password_123

# SMTP Mailer (for future alert and notification phases)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_username_placeholder
SMTP_PASS=smtp_password_placeholder
SMTP_FROM="APAAR Integrity Platform" <no-reply@example.gov.in>

# Optional Custom DNS toggle (default: true)
# Set to false if executing in an environment that restricts public DNS resolvers (1.1.1.1, 8.8.8.8)
ENABLE_CUSTOM_DNS=true
